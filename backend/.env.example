# Copia este archivo como backend/.env (ignorado por Git) y completa tus valores locales.
# El backend lo carga al arrancar desde la carpeta backend/.

# Base de datos: crea antes una base vacía llamada "galiledu" en tu PostgreSQL 18.
DB_URL=jdbc:postgresql://localhost:5433/galiledu
DB_USER=postgres
DB_PASSWORD=cambiar-por-tu-clave-local

# Opcional: secreto JWT propio (mínimo 32 caracteres).
# JWT_SECRET=

# Opcional: SMTP para enviar las credenciales por correo. Sin esto, se muestran en el log.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=
