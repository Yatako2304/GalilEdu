# Configuración de producción. En el servidor se copia como deploy/.env (ignorado por Git).
# El script deploy/instalar-servidor.sh lo crea solo, generando claves aleatorias.

# Contraseña de la base de datos (solo la usan los contenedores; no se expone a Internet).
DB_PASSWORD=cambiar-por-una-clave-larga

# Secreto para firmar las sesiones (JWT). Mínimo 32 caracteres. Si cambia, todos deben volver a iniciar sesión.
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres

# Dirección pública de la app, p. ej. http://3.85.12.34 (la Elastic IP del EC2) o https://galiledu.midominio.com
URL_PUBLICA=http://localhost

# Datos de prueba (usuarios U20260001… con contraseña Galiledu2026).
# - Para la DEMO del curso déjalo así: el profesor necesita esas cuentas para revisar cada rol.
# - Para uso real, quítalos:  FLYWAY_LOCATIONS=classpath:db/migration
#   ¡Ojo! Con datos de prueba, cualquiera que conozca el repo puede entrar como administrador.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/datos-prueba

# Correo para enviar credenciales (Gmail con contraseña de aplicación). Vacío = se escriben en el log.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Memoria del backend (t3.small: 512m está bien; t3.micro: usa -Xmx384m).
JAVA_OPTS=-Xms256m -Xmx512m
