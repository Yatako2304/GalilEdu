# URL base del backend (todas las llamadas de src/lib/api-client.ts usan esta base).
# Recomendado en desarrollo: /api (Vite lo reenvía a http://localhost:8080, igual que nginx en producción).
# Para llamar directo al backend: http://localhost:8080/api (requiere CORS).
VITE_APP_API_URL=/api
# true  -> usa MSW (src/testing/mocks) y NO necesita backend
# false -> llama al backend real en VITE_APP_API_URL
VITE_APP_ENABLE_API_MOCKING=true
